INCDIR = $(PSPPATH)/include
# ./Scripts is here so the init tracer (Scripts/InitTrace.h) can be included by name from the
# Aurora sources under source/ without every call site spelling out a relative ../../.. path.
INCDIR += ./include ./source ./3libs ./Scripts
CFLAGS = -O3 -G0 -Wall -std=gnu99 -mpreferred-stack-boundary=4 -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration -Wno-error=int-conversion -MMD -MP
CXXFLAGS = -O3 -G0 -Wall -std=gnu++11 -mpreferred-stack-boundary=4 -fno-exceptions -fno-rtti -fpermissive -MMD -MP
ASFLAGS = $(CFLAGS)

# One-off compile-time switches, so a special build does not need this file edited:
#   make EXTRA_DEFS=-DMC_PERF_PROBE=1     the work-counter self-test (see Scripts/PerfCounters.h)
EXTRA_DEFS ?=
CFLAGS += $(EXTRA_DEFS)
CXXFLAGS += $(EXTRA_DEFS)

BUILD_PRX = 1
PSP_FW_VERSION=371
# PSP_LARGE_MEMORY = 1, and that number is the whole mechanism for "32 MB on a PSP-1000, 64 MB on a
# 2000/3000". It is a REQUEST, not a demand: the firmware grants the extra 32 MB only on hardware that
# has it and ignores the request on a PSP-1000, which stays at 32 MB. So MEMSIZE=1 is already dynamic,
# and nothing has to detect the model to get that -- which is why it is set here rather than worked out
# at runtime.
#
# The game's own detection is the other half and is already in place: it reports which partition it got
# and sizes its mob caps to match ("memory: freeKB=... => BASE (32MB partition)" and the "mob caps
# bigMemory=..." line beside it). With the request granted it reports the expanded partition instead.
#
# The SDK turns this into the EBOOT's MEMSIZE field, which the KERNEL reads at boot. build.mak maps it
# like this:
#
#     EXPAND_MEMORY = 0
#     ifeq ($(shell test $(PSP_FW_VERSION) -gt 390; echo $$?),0)
#     EXPAND_MEMORY = 2                        # FW above 3.90: expanded is the default
#       PSP_LARGE_MEMORY=1 -> 1                 # and the SDK warns this is no longer necessary
#       PSP_LARGE_MEMORY=0 -> 0                 # opting OUT is how you ask for less
#       PSP_LARGE_MEMORY=2 -> 2
#     else
#       PSP_LARGE_MEMORY=1 -> 1
#       PSP_LARGE_MEMORY=2 -> 2                 # unset leaves it at 0
#     endif
#
# This file sets PSP_FW_VERSION=371, which is NOT above 390, so it takes the second branch. Writing the
# value out matters: deleting the line produces MEMSIZE=0, which asks for LESS memory.
#
# WHY IT WAS 2, AND WHY IT IS 1 AGAIN. It was changed to 2 while chasing a launch failure -- the game
# installed correctly and then went down when loadexec was asked to run it, with the log stopping on the
# launch line. That reading was wrong: the launch crash is fstat hanging in a process started by
# loadexec, and it is fixed in Scripts/FstatFix.c. It was never a memory-partition problem, and the note
# that used to sit here was wrong on the two things it leaned on -- MEMSIZE=2 is not "the larger of the
# two" (it asks for nothing, so the game ran in the 32 MB partition on every console), and the handoff
# boot failing is not explained by the request, because it failed with the Updater's MEMSIZE=2 EBOOT as
# well. What that cost was visible in a world: "HEAP GUARD: OUT OF MEMORY allocating 98304 bytes", with
# the heap guard reporting no leak, no overrun and no double free -- simply a full 16 MB heap.
PSP_LARGE_MEMORY = 1

LIBDIR += ./3libs/noisepp ./3libs/libpspmath
# -Map writes Tutorial1.map: it records where every input section landed, which is the only
# way to name an address that has no symbol in the final .symtab (the generator/mesher code
# ships as unnamed local code). tools/symbolize-crash.py falls back to it when needed.
LDFLAGS = -Wl,-Map=Tutorial1.map
LIBS=  -lNoisepp -lpspaudiolib -lpspaudio -lpspaudiocodec -lpng -lz -lpspgum -lpspgu -lstdc++ -lpsprtc -lpspctrl -lm -lpspvfpu -lpspsdk -lpsppower -lpsphttp -lpspssl -lpsputility -lpspmath #-lmikmod -lmmio -lpsp_req -lcurl -lTiny
# -lpsphttp    the HTTP client the updater downloads through (see Scripts/Updater.cpp)
# -lpspssl     HTTPS for the GitHub Releases channel (sceSsl / sceHttps, see Scripts/Updater.cpp)
# -lpsputility sceUtilityLoadNetModule / sceUtilityNetconf* -- loading the net modules and showing
#              the system's own access-point picker. build.mak adds -lpspnet and -lpspnet_apctl for
#              us (see its USE_KERNEL_LIBS block), so those are deliberately not repeated here.

EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = Minecraft
PSP_EBOOT_ICON = ICON0.png
PSP_EBOOT_PIC1 = PIC1.png

PSPSDK=$(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
-include $(OBJS:.o=.d)

# -lpspsystemctrl_user: sctrlKernelLoadExecVSHWithApitype, the CFW's own launcher, used by the updater
# to hand off to the Updater EBOOT (see Scripts/Updater.cpp). Stub module SystemCtrlForUser -- a
# *user-mode* stub, so a game can call it without a kernel addon.
#
# Appended after the include, not added to the LIBS line above, and that placement is deliberate.
# build.mak prepends its own libraries to LIBS, so a lib named above would be linked ahead of them;
# psp-fixup-imports then warns "stubs out of order ... your binary may or not work". This library is not
# in the psp-gcc driver's own spec either, so unlike -lpspuser it genuinely has to be named -- and
# naming it here links it last, alongside that spec's trailing entries, which is where it belongs.
LIBS += -lpspsystemctrl_user
